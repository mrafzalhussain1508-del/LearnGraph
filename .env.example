# ========================================================
# LearnGraph Environment Configuration Template (.env.example)
# ========================================================

# 1. Google Gemini API Key
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Resend Email Delivery API Key
# Configure your production Resend API key at: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Optional: Verified custom sender domain in Resend
# RESEND_FROM_EMAIL=LearnGraph <noreply@yourdomain.com>

# 3. WhatsApp OTP Configuration (Optional Twilio Integration)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=+14155238886
